{
  "version": "nr.rules/v1",
  "kind": "exposuresignatures",
  "signatures": [
    {
      "id": "git-config",
      "path": ".git/config",
      "category": "leak",
      "severity": "high",
      "mustContainAny": [
        "[core]",
        "[remote",
        "[branch"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype"
      ]
    },
    {
      "id": "git-head",
      "path": ".git/HEAD",
      "category": "leak",
      "severity": "medium",
      "pattern": "ref:\\s*refs/",
      "mustNotContain": [
        "<html",
        "<!doctype"
      ]
    },
    {
      "id": "env-file",
      "path": ".env",
      "category": "leak",
      "severity": "high",
      "pattern": "(?m)^[A-Z][A-Z0-9_]{1,}=",
      "mustContainAny": [
        "APP_",
        "DB_",
        "SECRET",
        "API",
        "PASSWORD",
        "TOKEN",
        "KEY"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype"
      ]
    },
    {
      "id": "wp-config-backup",
      "path": "wp-config.php.bak",
      "category": "leak",
      "severity": "critical",
      "mustContainAny": [
        "DB_PASSWORD",
        "DB_USER"
      ],
      "mustNotContain": [
        "<?php"
      ]
    },
    {
      "id": "sql-dump",
      "path": "backup.sql",
      "category": "leak",
      "severity": "high",
      "mustContainAny": [
        "CREATE TABLE",
        "INSERT INTO",
        "DROP TABLE"
      ]
    },
    {
      "id": "ds-store",
      "path": ".DS_Store",
      "category": "leak",
      "severity": "low",
      "mustContain": [
        "Bud1"
      ]
    },
    {
      "id": "directory-listing",
      "path": "",
      "category": "exposure",
      "severity": "medium",
      "mustContainAny": [
        "Index of /",
        "Directory listing for",
        "<title>Index of"
      ]
    },
    {
      "id": "phpinfo",
      "path": "phpinfo.php",
      "category": "exposure",
      "severity": "medium",
      "mustContainAny": [
        "phpinfo()",
        "PHP Version",
        "<title>phpinfo"
      ]
    },
    {
      "id": "spring-actuator-env",
      "path": "actuator/env",
      "category": "exposure",
      "severity": "high",
      "mustContain": [
        "propertySources"
      ]
    },
    {
      "id": "spring-heapdump",
      "path": "actuator/heapdump",
      "category": "exposure",
      "severity": "high",
      "mustContainAny": [
        "JAVA PROFILE",
        "HPROF"
      ]
    },
    {
      "id": "swagger",
      "path": "swagger.json",
      "category": "exposure",
      "severity": "info",
      "mustContainAny": [
        "\"swagger\"",
        "\"openapi\""
      ]
    },
    {
      "id": "server-status",
      "path": "server-status",
      "category": "exposure",
      "severity": "low",
      "mustContainAny": [
        "Apache Server Status",
        "Scoreboard Key"
      ]
    },
    {
      "id": "laravel-log",
      "path": "storage/logs/laravel.log",
      "category": "leak",
      "severity": "medium",
      "mustContainAny": [
        "production.ERROR",
        "local.ERROR",
        "stacktrace",
        "#0 {main}"
      ]
    },
    {
      "id": "npmrc",
      "path": ".npmrc",
      "category": "leak",
      "severity": "high",
      "pattern": "_authToken=",
      "mustNotContain": [
        "<html"
      ]
    },
    {
      "id": "svn-wc-db",
      "path": ".svn/wc.db",
      "category": "leak",
      "severity": "medium",
      "mustContainAny": [
        "SQLite format",
        "svn:"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "hg-store",
      "path": ".hg/requires",
      "category": "leak",
      "severity": "low",
      "mustContainAny": [
        "revlogv",
        "dotencode",
        "fncache"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "bzr-branch",
      "path": ".bzr/branch-format",
      "category": "leak",
      "severity": "low",
      "mustContainAny": [
        "Bazaar-NG",
        "Bazaar branch format"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "htpasswd",
      "path": ".htpasswd",
      "category": "secret",
      "severity": "high",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "[^:\\s]+:\\$(apr1|2y|1|6|5)\\$"
    },
    {
      "id": "htaccess",
      "path": ".htaccess",
      "category": "config",
      "severity": "low",
      "mustContainAny": [
        "RewriteEngine",
        "AuthType",
        "<Files",
        "Options ",
        "Deny from"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "aws-credentials",
      "path": ".aws/credentials",
      "category": "secret",
      "severity": "critical",
      "mustContainAny": [
        "aws_access_key_id",
        "aws_secret_access_key"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "pypirc",
      "path": ".pypirc",
      "category": "secret",
      "severity": "high",
      "mustContain": [
        "[pypi]"
      ],
      "mustContainAny": [
        "password",
        "username"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "netrc",
      "path": ".netrc",
      "category": "secret",
      "severity": "high",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "machine\\s+\\S+\\s+login\\s+\\S+"
    },
    {
      "id": "git-credentials",
      "path": ".git-credentials",
      "category": "secret",
      "severity": "critical",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "https?://[^:@\\s]+:[^@\\s]+@"
    },
    {
      "id": "dockercfg",
      "path": ".dockercfg",
      "category": "secret",
      "severity": "high",
      "mustContainAny": [
        "\"auths\"",
        "\"auth\":",
        "registry"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "env-backup",
      "path": ".env.bak",
      "category": "secret",
      "severity": "high",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "(?m)^[A-Z][A-Z0-9_]{2,}="
    },
    {
      "id": "wp-config-bak",
      "path": "wp-config.php.bak",
      "category": "secret",
      "severity": "critical",
      "mustContainAny": [
        "DB_PASSWORD",
        "DB_NAME",
        "AUTH_KEY"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "composer-json",
      "path": "composer.json",
      "category": "config",
      "severity": "low",
      "mustContain": [
        "\"require\""
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "package-json",
      "path": "package.json",
      "category": "config",
      "severity": "low",
      "mustContain": [
        "\"dependencies\""
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "terraform-state",
      "path": "terraform.tfstate",
      "category": "secret",
      "severity": "critical",
      "mustContain": [
        "\"terraform_version\""
      ],
      "mustContainAny": [
        "\"resources\"",
        "\"lineage\""
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "dockerfile",
      "path": "Dockerfile",
      "category": "config",
      "severity": "low",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "(?m)^(FROM|RUN|COPY|ENV|EXPOSE)\\s"
    },
    {
      "id": "docker-compose",
      "path": "docker-compose.yml",
      "category": "config",
      "severity": "medium",
      "mustContain": [
        "services:"
      ],
      "mustContainAny": [
        "image:",
        "build:"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "id-rsa",
      "path": "id_rsa",
      "category": "secret",
      "severity": "critical",
      "mustContainAny": [
        "BEGIN RSA PRIVATE KEY",
        "BEGIN OPENSSH PRIVATE KEY",
        "BEGIN PRIVATE KEY"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "web-config",
      "path": "web.config",
      "category": "config",
      "severity": "medium",
      "mustContainAny": [
        "<configuration>",
        "<connectionStrings>",
        "<system.web>"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "gitlab-ci",
      "path": ".gitlab-ci.yml",
      "category": "config",
      "severity": "low",
      "mustContainAny": [
        "stages:",
        "script:",
        "image:",
        "before_script:"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "github-workflow",
      "path": ".github/workflows/main.yml",
      "category": "config",
      "severity": "low",
      "mustContainAny": [
        "runs-on:",
        "uses:",
        "jobs:",
        "steps:"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "circleci",
      "path": ".circleci/config.yml",
      "category": "config",
      "severity": "low",
      "mustContainAny": [
        "version:",
        "jobs:",
        "workflows:",
        "orbs:"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "travis",
      "path": ".travis.yml",
      "category": "config",
      "severity": "low",
      "mustContainAny": [
        "language:",
        "script:",
        "install:"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "jenkinsfile",
      "path": "Jenkinsfile",
      "category": "config",
      "severity": "low",
      "mustContainAny": [
        "pipeline {",
        "node {",
        "stage(",
        "agent "
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "makefile",
      "path": "Makefile",
      "category": "config",
      "severity": "low",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "(?m)^[a-zA-Z0-9_.-]+:\\s*$|^\\t@?[a-z]"
    },
    {
      "id": "dockerignore",
      "path": ".dockerignore",
      "category": "config",
      "severity": "low",
      "mustContainAny": [
        "node_modules",
        ".git",
        "*.log",
        "Dockerfile"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "gitignore",
      "path": ".gitignore",
      "category": "config",
      "severity": "low",
      "mustContainAny": [
        "node_modules/",
        "*.log",
        ".env",
        ".DS_Store",
        "__pycache__"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "gitlab-runner-config",
      "path": "config.toml",
      "category": "secret",
      "severity": "high",
      "mustContainAny": [
        "[[runners]]",
        "concurrent",
        "registration_token",
        "token ="
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "kube-config",
      "path": ".kube/config",
      "category": "secret",
      "severity": "critical",
      "mustContainAny": [
        "apiVersion: v1",
        "clusters:",
        "client-certificate-data",
        "current-context"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "kubeconfig-yaml",
      "path": "kubeconfig",
      "category": "secret",
      "severity": "critical",
      "mustContainAny": [
        "client-key-data",
        "certificate-authority-data",
        "current-context"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "aws-config",
      "path": ".aws/config",
      "category": "secret",
      "severity": "high",
      "mustContainAny": [
        "[default]",
        "region =",
        "output =",
        "aws_access_key"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "gcloud-creds",
      "path": "application_default_credentials.json",
      "category": "secret",
      "severity": "critical",
      "mustContainAny": [
        "\"client_secret\"",
        "\"refresh_token\"",
        "\"type\": \"authorized_user\""
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "service-account-json",
      "path": "service-account.json",
      "category": "secret",
      "severity": "critical",
      "mustContain": [
        "\"type\": \"service_account\""
      ],
      "mustContainAny": [
        "\"private_key\"",
        "\"client_email\""
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "ssh-config",
      "path": ".ssh/config",
      "category": "secret",
      "severity": "medium",
      "mustContainAny": [
        "Host ",
        "IdentityFile",
        "HostName",
        "ProxyCommand"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "known-hosts",
      "path": ".ssh/known_hosts",
      "category": "leak",
      "severity": "low",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "ssh-(rsa|ed25519|dss)|ecdsa-sha2"
    },
    {
      "id": "bash-history",
      "path": ".bash_history",
      "category": "leak",
      "severity": "medium",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "(?m)^(cd|ls|git|ssh|curl|wget|sudo|export|mysql|psql) "
    },
    {
      "id": "mysql-history",
      "path": ".mysql_history",
      "category": "leak",
      "severity": "medium",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "(?i)(select|insert|update|create|drop|grant)\\s"
    },
    {
      "id": "pgpass",
      "path": ".pgpass",
      "category": "secret",
      "severity": "high",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "[^:]+:[0-9]+:[^:]+:[^:]+:[^:]+"
    },
    {
      "id": "my-cnf",
      "path": ".my.cnf",
      "category": "secret",
      "severity": "high",
      "mustContainAny": [
        "[client]",
        "[mysql]",
        "password="
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "wp-debug-log",
      "path": "wp-content/debug.log",
      "category": "leak",
      "severity": "medium",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "\\[[0-9]{2}-[A-Za-z]{3}-[0-9]{4}|PHP (Warning|Notice|Fatal|Deprecated)"
    },
    {
      "id": "error-log",
      "path": "error.log",
      "category": "leak",
      "severity": "low",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "\\[[a-zA-Z]{3} [A-Za-z]{3} [0-9]|PHP (Warning|Fatal|Notice)"
    },
    {
      "id": "access-log",
      "path": "access.log",
      "category": "leak",
      "severity": "low",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "\"(GET|POST|PUT|HEAD) [^\"]* HTTP/[0-9.]+\""
    },
    {
      "id": "npm-debug",
      "path": "npm-debug.log",
      "category": "leak",
      "severity": "low",
      "mustContainAny": [
        "npm ERR!",
        "verbose stack",
        "silly "
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "yarn-error",
      "path": "yarn-error.log",
      "category": "leak",
      "severity": "low",
      "mustContainAny": [
        "Error:",
        "yarn install",
        "at Object"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "config-json",
      "path": "config.json",
      "category": "config",
      "severity": "low",
      "mustContain": [
        "{"
      ],
      "mustContainAny": [
        "\"host\"",
        "\"port\"",
        "\"database\"",
        "\"password\""
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "appsettings",
      "path": "appsettings.json",
      "category": "secret",
      "severity": "high",
      "mustContainAny": [
        "ConnectionStrings",
        "DefaultConnection",
        "\"Password\"",
        "\"Jwt\""
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    },
    {
      "id": "application-properties",
      "path": "application.properties",
      "category": "secret",
      "severity": "high",
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ],
      "pattern": "(?m)^(spring\\.datasource|server\\.port|.*password)="
    },
    {
      "id": "application-yml",
      "path": "application.yml",
      "category": "secret",
      "severity": "high",
      "mustContainAny": [
        "datasource:",
        "password:",
        "spring:",
        "server:"
      ],
      "mustNotContain": [
        "<html",
        "<!doctype",
        "<head>",
        "<!DOCTYPE",
        "<html>"
      ]
    }
  ]
}