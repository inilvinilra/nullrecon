    {
      "id": "env-file-exposure",
      "info": {
        "name": "Exposed .env file",
        "severity": "high",
        "tags": [
          "exposure",
          "env",
          "secret"
        ],
        "description": "A readable .env leaks application secrets and credentials.",
        "cwe": "CWE-538"
      },
      "requests": [
        {
          "method": "GET",
          "path": [
            "/.env",
            ".env.local",
            "/.env.production"
          ],
          "matchersCondition": "and",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "regex",
              "part": "body",
              "regex": [
                "(?m)^[A-Z0-9_]+=",
                "APP_KEY=",
                "DB_PASSWORD=",
                "SECRET"
              ],
              "condition": "or"
            },
            {
              "type": "word",
              "part": "body",
              "words": [
                "<html",
                "<!doctype",
                "<head>",
                "<HTML"
              ],
              "condition": "or",
              "negative": true
            }
          ]
        }
      ]
    },
