    {
      "id": "server-version-disclosure",
      "info": {
        "name": "Server version disclosure",
        "severity": "info",
        "tags": [
          "fingerprint",
          "disclosure"
        ],
        "description": "The Server response header discloses product and version."
      },
      "requests": [
        {
          "method": "GET",
          "path": [
            "/"
          ],
          "matchersCondition": "and",
          "matchers": [
            {
              "type": "header",
              "header": "Server",
              "regex": [
                "\\S+/\\d"
              ],
              "condition": "or"
            }
          ],
          "extractors": [
            {
              "type": "regex",
              "part": "header",
              "name": "server",
              "regex": [
                "Server:\\s*([^\\r\\n]+)"
              ],
              "group": 1
            }
          ]
        }
      ]
    }
