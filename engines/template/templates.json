{
  "templates": [
    {
      "id": "git-config-exposure",
      "info": {
        "name": "Exposed .git/config",
        "severity": "high",
        "tags": [
          "exposure",
          "git"
        ],
        "description": "A readable .git/config exposes repository metadata and remote URLs.",
        "cwe": "CWE-538"
      },
      "requests": [
        {
          "method": "GET",
          "path": [
            "/.git/config"
          ],
          "matchersCondition": "and",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "part": "body",
              "words": [
                "[core]",
                "repositoryformatversion"
              ],
              "condition": "and"
            }
          ],
          "extractors": [
            {
              "type": "regex",
              "part": "body",
              "name": "remote",
              "regex": [
                "url\\s*=\\s*(\\S+)"
              ],
              "group": 1
            }
          ]
        }
      ]
    },
    {
      "id": "git-head-exposure",
      "info": {
        "name": "Exposed .git/HEAD",
        "severity": "medium",
        "tags": [
          "exposure",
          "git"
        ],
        "description": "A readable .git/HEAD confirms an exposed git repository.",
        "cwe": "CWE-538"
      },
      "requests": [
        {
          "method": "GET",
          "path": [
            "/.git/HEAD"
          ],
          "matchersCondition": "and",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "regex",
              "part": "body",
              "regex": [
                "^ref:\\s*refs/"
              ],
              "condition": "or"
            },
            {
              "type": "word",
              "part": "body",
              "words": [
                "<html",
                "<!doctype",
                "<head>",
                "<HTML"
              ],
              "condition": "or",
              "negative": true
            }
          ]
        }
      ]
    },
